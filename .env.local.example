# ====================================================================
# HYDRONOURISH - WEB APPLICATION & BACKEND ENVIRONMENT CONFIGURATION
# ====================================================================

# 1. Supabase Project Configuration (Public / Client-Safe)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# 2. Server-Only Supabase Service Role Key (Netlify Functions Only - NEVER expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 3. Device Ingestion Secret Token (Shared secret between ESP32 and /api/device-telemetry)
DEVICE_SECRET_TOKEN=hn_device_secret_token_2026

# 4. Gmail Automated OTP Dispatch Credentials
VITE_GMAIL_USER=your-clinic-notification-email@gmail.com
VITE_GMAIL_APP_PASS=your-16-character-app-password

# 5. Optional AI Diagnostics
VITE_GEMINI_API_KEY=
VITE_OPENAI_API_KEY=
